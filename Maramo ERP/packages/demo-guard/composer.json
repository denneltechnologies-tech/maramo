{
    "name": "classivo/demo-guard",
    "description": "Safeguards for a public Classivo ERP demo: blocks destructive edits, caps uploads and shows a nightly-reset banner. Active only when APP_ENV=demo.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "school",
        "demo",
        "erp"
    ],
    "authors": [
        {
            "name": "Classivo Team",
            "email": "info@classivoerp.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "filament/filament": "^4.0"
    },
    "require-dev": {
        "classivo/core": "*",
        "spatie/laravel-permission": "^6.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Classivo\\DemoGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Classivo\\DemoGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Classivo\\DemoGuard\\DemoGuardServiceProvider"
            ]
        }
    },
    "suggest": {
        "classivo/payments": "Payment credential screens are read-only on the demo when installed."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
