{
    "name": "classivo/grading",
    "description": "Pure-PHP school grading engine: pluggable schemes (CBSE, ICSE/ISC, configurable state boards), term weightage, best-of-N, rounding, pass/fail with grace marks, co-scholastic grades. Optional Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "grading",
        "school",
        "cbse",
        "icse",
        "report-card",
        "cgpa",
        "education"
    ],
    "authors": [
        {
            "name": "Classivo Team",
            "email": "info@classivoerp.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "illuminate/support": "Enables the optional Laravel service provider and config file (^12.0)"
    },
    "autoload": {
        "psr-4": {
            "Classivo\\Grading\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Classivo\\Grading\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Classivo\\Grading\\Laravel\\GradingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
