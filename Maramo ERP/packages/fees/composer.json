{
    "name": "classivo/fees",
    "description": "Classivo ERP fees: fee heads, groups and masters, allocation, concessions, late fines, manual receipts (cash/cheque/bank transfer), refunds with credit notes, carry-forward, session rollover, defaulters and e-mail reminders. No payment gateway and no accounting: money movements are announced as events.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "school",
        "erp",
        "fees"
    ],
    "authors": [
        {
            "name": "Classivo Team",
            "email": "info@classivoerp.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "classivo/core": "*@dev",
        "barryvdh/laravel-dompdf": "^3.0",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "filament/filament": "^4.0",
        "classivo/students": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-permission": "^6.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Grant the fees.* permissions to roles (see FeesPermissionSeeder)."
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../students",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Classivo\\Fees\\": "src/",
            "Classivo\\Fees\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Classivo\\Fees\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Classivo\\Fees\\FeesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
