{
    "name": "classivo/core",
    "description": "Classivo ERP core: school, branch, academic session, classes, sections and subjects with a pluggable tenancy contract.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "school",
        "erp",
        "education"
    ],
    "authors": [
        {
            "name": "Classivo Team",
            "email": "info@classivoerp.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "filament/filament": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Classivo\\Core\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Classivo\\Core\\CoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Classivo\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
